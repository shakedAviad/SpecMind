# Required. OpenAI API key used by the LLM client.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# Optional. Defaults to text-embedding-3-small.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional. Defaults to 1536. Must match the dimensions produced by OPENAI_EMBEDDING_MODEL.
OPENAI_EMBEDDING_DIMENSIONS=1536

# Optional. Defaults to http://localhost:6333.
QDRANT_URL=http://localhost:6333

# Optional. Defaults to jls_chunks.
QDRANT_COLLECTION_NAME=jls_chunks

# Optional. Defaults to jls25.pdf. Path to the Java Language Specification PDF
# used to build the BM25 index at startup.
JLS_PDF_PATH=jls25.pdf
